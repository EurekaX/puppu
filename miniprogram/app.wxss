page {
  --primary: #8ac68a;
  --primary-deep: #6faa6f;
  --primary-contrast: #FFFFFF;
  --primary-light: #EDF6E7;
  --leaf: #A9C88F;
  --honey: #E7B957;
  --honey-light: #FFF2CF;
  --peach: #F2A07E;
  --peach-light: #FFE8DC;
  --danger: #D96C5F;
  --danger-light: #FCE8E2;
  --wood: #9A6A3D;
  --wood-light: #D8B783;
  --bg: #F8F8F0;
  --paper: #FFF9E8;
  --paper-deep: #F4EACF;
  --paper-soft: #FFFCF2;
  --text: #6F4B2A;
  --text-secondary: #8D765A;
  --text-muted: #B9A88E;
  --border: #D8C6A6;
  --border-light: #E9DEC8;
  --shadow-sm: 0 2rpx 0 #D8C6A6, 0 8rpx 18rpx rgba(86, 63, 36, 0.08);
  --shadow: 0 3rpx 0 #CDB994, 0 14rpx 28rpx rgba(86, 63, 36, 0.10);
  --shadow-press: 0 5rpx 0 #B99E73;
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  --space-2xl: 64rpx;
  --radius-sm: 18rpx;
  --radius: 26rpx;
  --radius-lg: 34rpx;
  --radius-full: 9999rpx;
  --font-xs: 22rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 34rpx;
  --font-xl: 42rpx;
  --page-padding: 28rpx;

  min-height: 100vh;
  background:
    radial-gradient(circle at 20% 18%, rgba(134, 181, 108, 0.14) 0 4rpx, transparent 5rpx),
    radial-gradient(circle at 78% 28%, rgba(231, 185, 87, 0.13) 0 3rpx, transparent 4rpx),
    linear-gradient(180deg, #FBF9EA 0%, #F4F0DE 100%);
  background-size: 96rpx 96rpx, 116rpx 116rpx, 100% 100%;
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: var(--font-md);
  font-weight: 500;
  line-height: 1.6;
  box-sizing: border-box;
}

view, text, image, input, button, scroll-view, swiper, swiper-item {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: inherit;
  font-size: inherit;
  font-weight: inherit;
}

button::after { border: none; }
input, textarea { border: none; outline: none; }

.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }
.text-center { text-align: center; }
.text-secondary { color: var(--text-secondary); }
.text-muted { color: var(--text-muted); }
.mt-xs { margin-top: var(--space-xs); }
.mt-sm { margin-top: var(--space-sm); }
.mt-md { margin-top: var(--space-md); }
.mt-lg { margin-top: var(--space-lg); }
.mt-xl { margin-top: var(--space-xl); }
.ml-sm { margin-left: var(--space-sm); }
.ml-md { margin-left: var(--space-md); }
.mb-sm { margin-bottom: var(--space-sm); }
.mb-md { margin-bottom: var(--space-md); }

.card {
  position: relative;
  z-index: 1;
  margin: var(--space-sm) var(--page-padding);
  padding: var(--space-md);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  background:
    radial-gradient(circle at 16rpx 16rpx, rgba(154, 106, 61, 0.06) 0 2rpx, transparent 3rpx),
    var(--paper);
  background-size: 42rpx 42rpx, 100% 100%;
  box-shadow: var(--shadow-sm);
}

.card:active {
  transform: translateY(2rpx);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: var(--space-lg) var(--page-padding) var(--space-sm);
  font-size: var(--font-sm);
  font-weight: 800;
  color: var(--wood);
  letter-spacing: 1rpx;
}

.section-title::before {
  content: "";
  width: 22rpx;
  height: 18rpx;
  border-radius: 50% 0 50% 50%;
  background: var(--leaf);
  transform: rotate(-28deg);
  box-shadow: 10rpx -2rpx 0 rgba(231, 185, 87, 0.55);
}

.empty-state {
  min-height: 56vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-2xl) var(--space-xl);
}

.empty-hero-icon, .empty-icon {
  width: 172rpx;
  height: 172rpx;
  margin-bottom: var(--space-lg);
}

.empty-text {
  font-size: var(--font-lg);
  color: var(--text);
  font-weight: 800;
  text-align: center;
}

.empty-sub {
  margin-top: var(--space-xs);
  font-size: var(--font-sm);
  color: var(--text-secondary);
  text-align: center;
}

.btn {
  min-height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 36rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-md);
  font-weight: 800;
}

.btn:active {
  transform: translateY(4rpx);
}

.btn-primary {
  color: var(--primary-contrast);
  background: var(--primary);
  border: 2rpx solid var(--primary-deep);
  box-shadow: var(--shadow-press);
}

.btn-outline {
  color: #FFFFFF;
  background: var(--primary);
  border: 2rpx solid var(--primary);
  box-shadow: var(--shadow-sm);
}

.btn-danger {
  color: #FFFFFF;
  background: var(--danger);
  border: 2rpx solid #B9574D;
  box-shadow: 0 5rpx 0 #B9574D;
}

.btn-ghost {
  color: var(--text-secondary);
  background: var(--paper-deep);
  border: 2rpx solid var(--border);
}

.btn-sm {
  min-height: 64rpx;
  padding: 12rpx 26rpx;
  font-size: var(--font-sm);
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38rpx;
  padding: 2rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-xs);
  font-weight: 800;
  border: 2rpx solid rgba(111, 75, 42, 0.10);
  white-space: nowrap;
}

.tag-safe { background: var(--primary-light); color: var(--primary-deep); }
.tag-warning { background: var(--honey-light); color: #9B6417; }
.tag-danger { background: var(--danger-light); color: var(--danger); }

.form-group { margin-bottom: var(--space-lg); }

.form-label {
  display: block;
  margin-bottom: var(--space-sm);
  font-size: var(--font-sm);
  font-weight: 800;
  color: var(--wood);
}

.form-label .required {
  color: var(--danger);
  margin-left: 4rpx;
}

.form-input, .picker-value {
  width: 100%;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--space-md);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-full);
  background: var(--paper);
  color: var(--text);
  font-size: var(--font-md);
  font-weight: 600;
  box-shadow: 0 3rpx 0 #D8C6A6;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx var(--space-md);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  background: var(--paper);
  color: var(--text);
  font-size: var(--font-md);
  box-shadow: 0 3rpx 0 #D8C6A6;
}

.picker-value .placeholder { color: var(--text-muted); }
.picker-value .arrow {
  width: 16rpx;
  height: 16rpx;
  border-right: 2rpx solid var(--text-secondary);
  border-bottom: 2rpx solid var(--text-secondary);
  transform: rotate(45deg);
}

.gender-options {
  display: flex;
  gap: var(--space-sm);
}

.gender-chip {
  flex: 1;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-full);
  background: var(--paper);
  color: var(--text-secondary);
  font-size: var(--font-sm);
  font-weight: 700;
}

.gender-chip.active {
  border-color: var(--primary);
  background: var(--primary);
  color: #FFFFFF;
}

.field-hint {
  margin-top: var(--space-xs);
  color: var(--text-secondary);
  font-size: var(--font-sm);
}

.input-with-suffix {
  position: relative;
  display: flex;
  align-items: center;
}

.input-suffix {
  position: absolute;
  right: var(--space-md);
  color: var(--text-muted);
  font-size: var(--font-sm);
}

.form-page {
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.form-page .form-body {
  padding: var(--space-lg) var(--page-padding);
}

.form-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--page-padding);
  padding-bottom: calc(var(--space-sm) + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--border-light);
  background: rgba(255, 249, 232, 0.96);
}

.form-footer .btn {
  flex: 1;
  height: 92rpx;
}

.fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(118rpx + env(safe-area-inset-bottom) + 34rpx);
  z-index: 30;
  width: 106rpx;
  height: 106rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FFFFFF;
  border-radius: 50%;
  background: var(--primary);
  color: #FFFFFF;
  box-shadow: 0 5rpx 0 #B99E73, 0 12rpx 24rpx rgba(86, 63, 36, 0.16);
}

.fab:active {
  transform: translateY(5rpx) scale(0.96);
  box-shadow: 0 1rpx 0 #B99E73, 0 8rpx 18rpx rgba(86, 63, 36, 0.12);
}

.fab text {
  font-size: 54rpx;
  font-weight: 500;
  line-height: 1;
}

.fab image {
  width: 62rpx;
  height: 62rpx;
}

.divider {
  height: 2rpx;
  margin: var(--space-sm) 0;
  background: linear-gradient(90deg, transparent, var(--border-light), transparent);
}

.segment-bar {
  display: flex;
  margin: var(--space-md) var(--page-padding);
  padding: 8rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-full);
  background: var(--paper-deep);
  box-shadow: inset 0 2rpx 8rpx rgba(111, 75, 42, 0.08);
}

.segment-item {
  flex: 1;
  min-height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  color: var(--text-secondary);
  font-size: var(--font-sm);
  font-weight: 800;
}

.segment-item.active {
  color: var(--primary-contrast);
  background: var(--primary);
  box-shadow: 0 3rpx 0 #6faa6f;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.96); }
  to { opacity: 1; transform: scale(1); }
}

.animate-fade-in, .animate-fade-in-up { animation: fadeIn 0.32s ease both; }
.animate-scale-in { animation: scaleIn 0.28s ease both; }
.animate-delay-1 { animation-delay: 0.04s; }
.animate-delay-2 { animation-delay: 0.08s; }
.animate-delay-3 { animation-delay: 0.12s; }
.animate-delay-4 { animation-delay: 0.16s; }
.animate-delay-5 { animation-delay: 0.20s; }
