<view class="tabbar-container">
  <view wx:for="{{list}}" wx:key="index"
    class="tabbar-item"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
    bindtap="switchTab">
    <image class="tabbar-icon"
      src="{{selected === index ? item.selectedIconPath : item.iconPath}}"
      mode="aspectFit" />
  </view>
</view>
