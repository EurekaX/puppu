.tabbar-container {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 9999;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  border: 2rpx solid #D8C6A6;
  border-radius: 36rpx;
  background: rgba(255, 249, 232, 0.96);
  box-shadow: 0 4rpx 0 #CDB994, 0 -8rpx 28rpx rgba(86, 63, 36, 0.12);
  box-sizing: border-box;
}

.tabbar-item {
  height: 88rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8D765A;
  font-size: 20rpx;
  font-weight: 800;
}

.tabbar-item.active {
  color: #4F7A3C;
}

.tabbar-icon {
  width: 50rpx;
  height: 50rpx;
  display: block;
}

.tabbar-label {
  margin-top: 2rpx;
  line-height: 1;
}
