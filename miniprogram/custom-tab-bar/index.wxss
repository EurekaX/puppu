.tabbar-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(110rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  background-color: rgba(248, 248, 240, 0.96);
  border-top: 2rpx solid #E4D9C3;
  box-sizing: border-box;
  z-index: 9999;
  box-shadow: 0 -6rpx 20rpx rgba(61, 52, 40, 0.08);
}

.tabbar-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 110rpx;
  flex: 1;
}

.tabbar-icon {
  width: 54rpx;
  height: 54rpx;
  display: block;
  border-radius: 18rpx;
}
