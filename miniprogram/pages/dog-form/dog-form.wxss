/* ── Avatar ── */
.avatar-upload {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--card-bg-warm);
  border: 2rpx dashed var(--border);
  box-shadow: 0 2rpx 0 #D8CDB7;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-sm);
}
.avatar-upload image {
  width: 100%;
  height: 100%;
}
.avatar-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.avatar-icon-img {
  width: 104rpx;
  height: 104rpx;
  display: block;
  margin-bottom: 6rpx;
}
.avatar-hint {
  font-size: var(--font-xs);
  color: var(--text-muted);
  letter-spacing: 1rpx;
}

.unit {
  font-size: var(--font-xs);
  color: var(--text-muted);
  font-weight: 350;
  text-transform: none;
  letter-spacing: 0;
}
