<view class="dashboard">
  <view class="empty-state animate-scale-in" wx:if="{{dogs.length === 0}}">
    <image class="empty-hero-icon" src="/images/animal-icons/dog-avatar.png" mode="aspectFit" />
    <text class="empty-text">还没有添加狗狗</text>
    <text class="empty-sub">先建立小档案，再开始记录疫苗、驱虫和存粮</text>
    <button class="btn btn-primary mt-xl empty-action" bindtap="onAddDog">添加狗狗</button>
  </view>

  <block wx:if="{{dogs.length > 0}}">
    <view class="island-board animate-fade-in">
      <picker mode="selector" range="{{dogNames}}" value="{{currentDogIndex}}" bindchange="onSwitchDog">
        <view class="dog-switcher">
          <view class="avatar-ring">
            <image wx:if="{{currentDog.avatar}}" src="{{currentDog.avatar}}" mode="aspectFill" />
            <image wx:else class="avatar-icon-img" src="/images/animal-icons/dog-avatar.png" mode="aspectFit" />
          </view>
          <view class="dog-info">
            <view class="board-kicker">今日照看</view>
            <view class="dog-name">{{currentDog.name}}</view>
            <view class="dog-meta">{{currentDog.breed}}<text class="dot"> · </text>{{currentDog.age}}</view>
          </view>
          <view class="switch-pill">切换</view>
        </view>
      </picker>
    </view>

    <view class="section-title">健康小木牌</view>
    <view class="status-grid animate-fade-in-up">
      <view class="status-card {{vaccineStatus}}">
        <view class="status-copy">
          <text class="status-type">疫苗</text>
          <text class="status-value">{{vaccineStatusLabel}}</text>
        </view>
        <image class="status-icon-img" src="/images/animal-icons/vaccine.png" mode="aspectFit" />
      </view>
      <view class="status-card {{dewormStatus}}">
        <view class="status-copy">
          <text class="status-type">驱虫</text>
          <text class="status-value">{{dewormStatusLabel}}</text>
        </view>
        <image class="status-icon-img" src="/images/animal-icons/deworm.png" mode="aspectFit" />
      </view>
      <view class="status-card {{foodStockStatus}} wide">
        <view class="status-copy">
          <text class="status-type">存粮</text>
          <text class="status-value">{{foodStockStatusLabel}}</text>
        </view>
        <image class="status-icon-img" src="/images/animal-icons/food-bowl.png" mode="aspectFit" />
      </view>
    </view>

    <view class="quick-record-book animate-fade-in-up animate-delay-2">
      <view class="book-binding">
        <view class="binding-ring"></view>
        <view class="binding-ring"></view>
        <view class="binding-ring"></view>
        <view class="binding-ring"></view>
      </view>
      <view class="book-leaf leaf-one"></view>
      <view class="book-leaf leaf-two"></view>

      <view class="quick-record-header">
        <view>
          <view class="quick-record-title">宠物记录小本本</view>
          <view class="quick-record-subtitle">记录TA的每一次守护</view>
        </view>
        <view class="book-sticker">PUP</view>
      </view>

      <swiper class="quick-record-swiper" current="{{quickRecordIndex}}" bindchange="onQuickRecordPageChange" circular="{{true}}" duration="{{360}}">
        <swiper-item>
          <view class="quick-record-page vaccine-page">
            <button class="quick-record-card" bindtap="onAddVaccine">
              <view class="page-curl"></view>
              <view class="record-icon-wrap">
                <image class="record-icon-img" src="/images/animal-icons/vaccine.png" mode="aspectFit" />
              </view>
              <view class="record-copy">
                <view class="record-card-kicker">Vaccine</view>
                <view class="record-card-title">记疫苗</view>
                <view class="record-card-desc">把下一次守护日期记下来</view>
              </view>
              <view class="record-card-action">去记录</view>
            </button>
          </view>
        </swiper-item>
        <swiper-item>
          <view class="quick-record-page deworm-page">
            <button class="quick-record-card" bindtap="onAddDeworm">
              <view class="page-curl"></view>
              <view class="record-icon-wrap">
                <image class="record-icon-img" src="/images/animal-icons/deworm.png" mode="aspectFit" />
              </view>
              <view class="record-copy">
                <view class="record-card-kicker">Deworm</view>
                <view class="record-card-title">记驱虫</view>
                <view class="record-card-desc">定期护理，小肚肚更安心</view>
              </view>
              <view class="record-card-action">去记录</view>
            </button>
          </view>
        </swiper-item>
        <swiper-item>
          <view class="quick-record-page food-page">
            <button class="quick-record-card" bindtap="onAddFoodStock">
              <view class="page-curl"></view>
              <view class="record-icon-wrap">
                <image class="record-icon-img" src="/images/animal-icons/food-bowl.png" mode="aspectFit" />
              </view>
              <view class="record-copy">
                <view class="record-card-kicker">Food</view>
                <view class="record-card-title">记存粮</view>
                <view class="record-card-desc">看看家里的粮袋还够不够</view>
              </view>
              <view class="record-card-action">去记录</view>
            </button>
          </view>
        </swiper-item>
      </swiper>

      <view class="quick-record-dots">
        <view class="quick-record-dot {{quickRecordIndex == 0 ? 'active' : ''}}"></view>
        <view class="quick-record-dot {{quickRecordIndex == 1 ? 'active' : ''}}"></view>
        <view class="quick-record-dot {{quickRecordIndex == 2 ? 'active' : ''}}"></view>
      </view>

      <view class="quick-record-hint">向左滑动，翻看下一页～</view>
    </view>

    <view class="section-title">
      近期提醒
      <text class="section-count" wx:if="{{reminders.length > 0}}">{{reminders.length}}</text>
    </view>

    <view wx:if="{{reminders.length === 0}}" class="card done-card animate-fade-in">
      <image class="done-icon-img" src="/images/animal-icons/check-leaf.png" mode="aspectFit" />
      <view class="done-title">7天内没有临期事项</view>
      <view class="done-sub">小岛今天很安稳</view>
    </view>

    <view wx:for="{{reminders}}" wx:key="_id"
      class="reminder-card card animate-fade-in-up {{'animate-delay-' + (index % 5 + 1)}}"
      bindtap="onTapReminder" data-item="{{item}}">
      <view class="reminder-main">
        <view class="reminder-dot {{item.tagColor}}"></view>
        <view class="reminder-copy">
          <view class="reminder-title">{{item.title}}</view>
          <view class="reminder-date">{{item.date}}</view>
        </view>
      </view>
      <view class="tag tag-{{item.tagColor}}">{{item.tagLabel}}</view>
    </view>
  </block>
</view>
