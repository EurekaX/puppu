.dashboard {
  min-height: 100vh;
  padding: 24rpx 0 calc(132rpx + env(safe-area-inset-bottom));
}

.island-board {
  margin: 8rpx var(--page-padding) var(--space-md);
  padding: 28rpx;
  border: 3rpx solid var(--wood-light);
  border-radius: var(--radius-lg);
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.40), transparent 42%),
    radial-gradient(circle at 92% 16%, rgba(231, 185, 87, 0.22) 0 36rpx, transparent 38rpx),
    var(--paper);
  box-shadow: var(--shadow);
  overflow: hidden;
}

.dog-switcher {
  display: flex;
  align-items: center;
  width: 100%;
}

.avatar-ring {
  width: 118rpx;
  height: 118rpx;
  border: 5rpx solid #FFFFFF;
  border-radius: 50%;
  background: var(--primary-light);
  box-shadow: 0 4rpx 0 #D8C6A6;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-ring image {
  width: 100%;
  height: 100%;
}

.avatar-icon-img {
  width: 94rpx;
  height: 94rpx;
}

.dog-info {
  min-width: 0;
  flex: 1;
  padding: 0 22rpx;
}

.board-kicker {
  font-size: var(--font-xs);
  color: var(--primary-deep);
  font-weight: 800;
}

.dog-name {
  max-width: 100%;
  color: var(--text);
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dog-meta {
  margin-top: 4rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dot { color: var(--text-muted); }

.switch-pill {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  border: 2rpx solid var(--primary);
  border-radius: var(--radius-full);
  background: var(--primary-light);
  color: var(--primary-deep);
  font-size: var(--font-xs);
  font-weight: 800;
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-sm);
  padding: 0 var(--page-padding);
}

.status-card {
  min-height: 158rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  background: var(--paper);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.status-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 14rpx;
  height: 100%;
  background: var(--leaf);
}

.status-card.safe { background: var(--primary-light); }
.status-card.warning { background: var(--honey-light); }
.status-card.overdue { background: var(--danger-light); }
.status-card.none { background: var(--paper); }
.status-card.warning::before { background: var(--honey); }
.status-card.overdue::before { background: var(--danger); }
.status-card.none::before { background: var(--text-muted); }
.status-card.wide { grid-column: span 2; }

.status-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding-left: 10rpx;
}

.status-type {
  color: var(--text-secondary);
  font-size: var(--font-xs);
  font-weight: 800;
}

.status-value {
  margin-top: 4rpx;
  color: var(--text);
  font-size: var(--font-md);
  font-weight: 900;
  line-height: 1.3;
}

.status-icon-img {
  width: 80rpx;
  height: 80rpx;
  margin-left: var(--space-sm);
  flex-shrink: 0;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-sm);
  margin: var(--space-md) var(--page-padding) 0;
}

.action-card {
  min-height: 168rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 18rpx 10rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  background: var(--paper);
  box-shadow: var(--shadow-sm);
}

.action-card:active {
  transform: translateY(4rpx);
}

.vaccine-action { border-color: rgba(134, 181, 108, 0.55); }
.deworm-action { border-color: rgba(231, 185, 87, 0.70); }
.food-action { border-color: rgba(154, 106, 61, 0.35); }

.action-icon-img {
  width: 82rpx;
  height: 82rpx;
}

.action-label {
  margin-top: 8rpx;
  color: var(--text);
  font-size: var(--font-sm);
  font-weight: 900;
}

.section-count {
  min-width: 34rpx;
  height: 34rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--honey);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 900;
}

.done-card {
  text-align: center;
  padding: var(--space-xl);
}

.done-icon-img {
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto var(--space-sm);
}

.done-title {
  color: var(--text);
  font-size: var(--font-md);
  font-weight: 900;
}

.done-sub {
  margin-top: 2rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
}

.reminder-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.reminder-main {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
}

.reminder-dot {
  width: 20rpx;
  height: 20rpx;
  margin-right: var(--space-sm);
  border-radius: 50% 0 50% 50%;
  background: var(--honey);
  transform: rotate(-28deg);
  flex-shrink: 0;
}

.reminder-dot.danger { background: var(--danger); }

.reminder-copy {
  min-width: 0;
}

.reminder-title {
  color: var(--text);
  font-size: var(--font-md);
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reminder-date {
  color: var(--text-secondary);
  font-size: var(--font-sm);
}

.empty-action {
  min-width: 260rpx;
}
