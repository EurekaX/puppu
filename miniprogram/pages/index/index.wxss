.dashboard {
  min-height: 100vh;
  padding: 24rpx 0 calc(132rpx + env(safe-area-inset-bottom));
}

.island-board {
  margin: 8rpx var(--page-padding) var(--space-md);
  padding: 28rpx;
  border: 3rpx solid var(--wood-light);
  border-radius: var(--radius-lg);
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.40), transparent 42%),
    radial-gradient(circle at 92% 16%, rgba(231, 185, 87, 0.22) 0 36rpx, transparent 38rpx),
    var(--paper);
  box-shadow: var(--shadow);
  overflow: hidden;
}

.dog-switcher {
  display: flex;
  align-items: center;
  width: 100%;
}

.avatar-ring {
  width: 118rpx;
  height: 118rpx;
  border: 5rpx solid #FFFFFF;
  border-radius: 50%;
  background: var(--primary-light);
  box-shadow: 0 4rpx 0 #D8C6A6;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-ring image {
  width: 100%;
  height: 100%;
}

.avatar-icon-img {
  width: 94rpx;
  height: 94rpx;
}

.dog-info {
  min-width: 0;
  flex: 1;
  padding: 0 22rpx;
}

.board-kicker {
  font-size: var(--font-xs);
  color: var(--primary-deep);
  font-weight: 800;
}

.dog-name {
  max-width: 100%;
  color: var(--text);
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dog-meta {
  margin-top: 4rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dot { color: var(--text-muted); }

.switch-pill {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  border: 2rpx solid var(--primary);
  border-radius: var(--radius-full);
  background: var(--primary);
  color: #FFFFFF;
  box-shadow: 0 3rpx 0 #6faa6f;
  font-size: var(--font-xs);
  font-weight: 800;
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  padding: 0 var(--page-padding);
}

.status-card {
  min-height: 158rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 22rpx 22rpx 42rpx;
  border: 3rpx solid var(--border);
  border-radius: var(--radius);
  background: var(--paper);
  box-shadow: 0 3rpx 0 #D8C6A6, 0 12rpx 22rpx rgba(86, 63, 36, 0.12);
  overflow: hidden;
}

.status-card::before {
  content: "";
  position: absolute;
  top: 18rpx;
  bottom: 18rpx;
  left: 16rpx;
  width: 12rpx;
  height: auto;
  border-radius: var(--radius-full);
  background: var(--leaf);
  box-shadow: 0 0 0 3rpx rgba(255, 255, 255, 0.72);
}

.status-card.safe {
  background: var(--primary);
  border-color: #6faa6f;
  color: #FFFFFF;
  box-shadow: 0 4rpx 0 #6faa6f, 0 14rpx 24rpx rgba(86, 63, 36, 0.16);
}
.status-card.warning { background: var(--honey-light); }
.status-card.overdue { background: var(--danger-light); }
.status-card.none { background: var(--paper); }
.status-card.warning::before { background: var(--honey); }
.status-card.overdue::before { background: var(--danger); }
.status-card.none::before { background: var(--text-muted); }
.status-card.safe::before { background: #FFFFFF; }
.status-card.wide { grid-column: span 2; }

.status-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.status-type {
  color: var(--text-secondary);
  font-size: var(--font-xs);
  font-weight: 800;
}

.status-value {
  margin-top: 4rpx;
  color: var(--text);
  font-size: var(--font-md);
  font-weight: 900;
  line-height: 1.3;
}

.status-card.safe .status-type,
.status-card.safe .status-value {
  color: #FFFFFF;
}

.status-icon-img {
  width: 80rpx;
  height: 80rpx;
  margin-left: var(--space-sm);
  flex-shrink: 0;
}

.quick-record-book {
  position: relative;
  margin: var(--space-md) var(--page-padding) 0;
  padding: 20rpx 18rpx 16rpx 58rpx;
  border: 3rpx solid #A8CE97;
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 24rpx 30rpx, rgba(138, 198, 138, 0.14) 0 3rpx, transparent 4rpx),
    radial-gradient(circle at 85% 24%, rgba(231, 185, 87, 0.12) 0 5rpx, transparent 6rpx),
    repeating-linear-gradient(180deg, transparent 0 43rpx, rgba(216, 198, 166, 0.16) 44rpx, transparent 46rpx),
    linear-gradient(135deg, rgba(255, 255, 255, 0.68), transparent 38%),
    linear-gradient(180deg, #FFFDF4 0%, #FFF7E6 100%);
  background-size: 54rpx 54rpx, 72rpx 72rpx, 100% 46rpx, 100% 100%, 100% 100%;
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.78),
    0 5rpx 0 #D8C6A6,
    0 14rpx 26rpx rgba(86, 63, 36, 0.10);
  overflow: hidden;
}

.quick-record-book::before {
  content: "";
  position: absolute;
  left: 38rpx;
  top: 24rpx;
  bottom: 22rpx;
  width: 4rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(180deg, rgba(168, 206, 151, 0.18), rgba(111, 75, 42, 0.16), rgba(168, 206, 151, 0.18));
}

.quick-record-book::after {
  content: "";
  position: absolute;
  right: -26rpx;
  bottom: -30rpx;
  width: 118rpx;
  height: 118rpx;
  border-radius: 50% 0 0 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.20), rgba(216, 198, 166, 0.30));
  transform: rotate(8deg);
  opacity: 0.42;
  pointer-events: none;
}

.book-binding {
  position: absolute;
  left: 16rpx;
  top: 46rpx;
  bottom: 48rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.binding-ring {
  width: 28rpx;
  height: 28rpx;
  border: 5rpx solid #B9D9A8;
  border-right-color: #E7D5B5;
  border-radius: 50%;
  background: #FFF9E8;
  box-shadow: inset 0 2rpx 4rpx rgba(86, 63, 36, 0.10), 0 2rpx 0 rgba(154, 106, 61, 0.18);
}

.book-leaf {
  display: none;
}

.leaf-one {
  top: 24rpx;
  right: 88rpx;
  transform: rotate(-28deg);
}

.leaf-two {
  right: 46rpx;
  bottom: 46rpx;
  background: rgba(231, 185, 87, 0.28);
  transform: rotate(32deg);
}

.quick-record-header {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  padding-right: 8rpx;
}

.quick-record-title {
  color: var(--text);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.2;
}

.quick-record-subtitle {
  margin-top: 4rpx;
  color: var(--text-secondary);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.3;
}

.quick-record-tabs {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4rpx;
  min-height: 48rpx;
  margin-top: 14rpx;
  padding: 5rpx;
  border: 2rpx solid rgba(168, 206, 151, 0.36);
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.34);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.60);
}

.quick-record-tab {
  min-width: 0;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  color: rgba(111, 75, 42, 0.66);
  font-size: 21rpx;
  font-weight: 900;
  transition: all 0.24s cubic-bezier(0.4, 0, 0.2, 1);
}

.quick-record-tab.active {
  background: var(--primary);
  color: #FFFFFF;
  box-shadow: 0 3rpx 0 #6faa6f;
}

.book-sticker {
  flex-shrink: 0;
  min-width: 62rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(138, 198, 138, 0.55);
  border-radius: var(--radius-full);
  background: #EEF7E7;
  color: #6FAA6F;
  font-size: 18rpx;
  font-weight: 900;
  box-shadow: 0 2rpx 0 rgba(138, 198, 138, 0.26);
}

.quick-record-swiper {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 166rpx;
  margin-top: 10rpx;
  overflow: visible;
  border-radius: 28rpx;
}

.quick-record-page {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  height: 100%;
  padding: 0;
  border-radius: 28rpx;
  border: 2rpx solid rgba(168, 206, 151, 0.30);
  background:
    linear-gradient(90deg, rgba(168, 206, 151, 0.18) 0 2rpx, transparent 2rpx),
    repeating-linear-gradient(180deg, transparent 0 38rpx, rgba(216, 198, 166, 0.22) 39rpx, transparent 40rpx),
    radial-gradient(circle at 92% 18%, rgba(255, 255, 255, 0.42) 0 30rpx, transparent 32rpx),
    radial-gradient(circle at 20rpx 22rpx, rgba(111, 75, 42, 0.045) 0 2rpx, transparent 3rpx),
    linear-gradient(180deg, #FFFDF4 0%, #FFF7E6 100%);
  background-size: 100% 100%, 100% 40rpx, 100% 100%, 40rpx 40rpx, 100% 100%;
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.70),
    inset 0 -2rpx 0 rgba(111, 75, 42, 0.045),
    0 4rpx 0 rgba(216, 198, 166, 0.42);
  overflow: hidden;
  perspective: 900rpx;
}

.quick-record-page::before,
.quick-record-page::after {
  content: "";
  position: absolute;
  top: 16rpx;
  right: 0;
  width: 42rpx;
  height: 136rpx;
  border-radius: 0 24rpx 28rpx 0;
  background: rgba(255, 249, 232, 0.86);
  box-shadow: 4rpx 5rpx 12rpx rgba(86, 63, 36, 0.08);
}

.quick-record-page::before {
  right: 10rpx;
  transform: rotate(2deg);
}

.quick-record-page::after {
  right: 22rpx;
  background: rgba(244, 234, 207, 0.48);
  transform: rotate(4deg);
  display: none;
}

.quick-record-card {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 18rpx 22rpx 18rpx 30rpx;
  border: 0;
  border-radius: 26rpx;
  background: transparent;
  box-shadow: none;
  overflow: hidden;
  transform-origin: left center;
  transition: transform 0.24s cubic-bezier(0.4, 0, 0.2, 1);
}

.quick-record-card::before {
  content: "";
  position: absolute;
  left: 16rpx;
  top: 22rpx;
  bottom: 22rpx;
  width: 4rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(180deg, rgba(168, 206, 151, 0.55), rgba(216, 198, 166, 0.38));
}

.quick-record-card::after {
  content: "";
  position: absolute;
  right: -18rpx;
  top: 0;
  width: 48rpx;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(111, 75, 42, 0.055));
  transform: skewX(-8deg);
  pointer-events: none;
}

.quick-record-card:active {
  transform: translateX(8rpx) rotateY(-7deg) scale(0.992);
}

.vaccine-page {
  --record-accent: #D8AA4D;
  z-index: 3;
}

.deworm-page {
  --record-accent: #D99583;
  z-index: 2;
}

.food-page {
  --record-accent: #78AE78;
  z-index: 1;
}

.page-curl {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 42rpx;
  height: 42rpx;
  border-radius: 28rpx 0 28rpx 0;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.70) 0 48%, rgba(216, 198, 166, 0.20) 52% 100%);
  box-shadow: -3rpx -3rpx 7rpx rgba(86, 63, 36, 0.055);
}

.record-icon-wrap {
  position: relative;
  z-index: 1;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  border: 2rpx solid rgba(216, 198, 166, 0.48);
  background: rgba(255, 255, 255, 0.54);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.72),
    0 3rpx 0 rgba(216, 198, 166, 0.62);
  flex-shrink: 0;
}

.record-icon-img {
  width: 56rpx;
  height: 56rpx;
}

.record-copy {
  position: relative;
  z-index: 1;
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
}

.record-card-kicker {
  display: none;
  color: var(--record-accent);
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
  text-transform: uppercase;
}

.record-card-title {
  position: relative;
  z-index: 1;
  margin-top: 0;
  color: var(--text);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
}

.record-card-desc {
  margin-top: 8rpx;
  color: rgba(111, 75, 42, 0.72);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-card-action {
  position: relative;
  z-index: 1;
  width: 94rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  border-radius: var(--radius-full);
  border: 2rpx solid rgba(216, 198, 166, 0.42);
  background: rgba(255, 255, 255, 0.58);
  color: #7A5A32;
  font-size: 20rpx;
  font-weight: 900;
  flex-shrink: 0;
  box-shadow: 0 2rpx 0 rgba(216, 198, 166, 0.48);
}

.quick-record-dots {
  display: none;
}

.quick-record-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: var(--radius-full);
  background: rgba(111, 75, 42, 0.22);
  transition: all 0.24s cubic-bezier(0.4, 0, 0.2, 1);
}

.quick-record-dot.active {
  width: 34rpx;
  background: var(--primary);
  box-shadow: 0 2rpx 0 #6faa6f;
}

.quick-record-hint {
  display: none;
}

.section-count {
  min-width: 34rpx;
  height: 34rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--honey);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 900;
}

.done-card {
  text-align: center;
  padding: var(--space-xl);
}

.done-icon-img {
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto var(--space-sm);
}

.done-title {
  color: var(--text);
  font-size: var(--font-md);
  font-weight: 900;
}

.done-sub {
  margin-top: 2rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
}

.reminder-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.reminder-main {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
}

.reminder-dot {
  width: 20rpx;
  height: 20rpx;
  margin-right: var(--space-sm);
  border-radius: 50% 0 50% 50%;
  background: var(--honey);
  transform: rotate(-28deg);
  flex-shrink: 0;
}

.reminder-dot.danger { background: var(--danger); }

.reminder-copy {
  min-width: 0;
}

.reminder-title {
  color: var(--text);
  font-size: var(--font-md);
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reminder-date {
  color: var(--text-secondary);
  font-size: var(--font-sm);
}

.empty-action {
  min-width: 260rpx;
}
