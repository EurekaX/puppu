.profile-page {
  min-height: 100vh;
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom) + 24rpx);
}

/* ── Header ── */
.profile-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: var(--space-lg) var(--page-padding) var(--space-sm);
}
.profile-title {
  font-size: var(--font-xl);
  font-weight: 500;
  letter-spacing: 1rpx;
}
.profile-count {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* ── Dog Card ── */
.dog-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card-bg);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  padding: 24rpx;
  margin: 16rpx var(--page-padding);
  transition: border-color 0.2s;
  box-shadow: var(--shadow-sm);
}

.dog-card.is-active {
  border-color: var(--primary);
  background: var(--primary-light);
}

/* Left: Avatar */
.dog-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--card-bg-warm);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid var(--border);
  box-shadow: 0 2rpx 0 #D8CDB7;
}
.dog-avatar image {
  width: 100%;
  height: 100%;
}
.avatar-icon-img {
  width: 82rpx;
  height: 82rpx;
  display: block;
}

/* Center: Info */
.dog-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 20rpx;
}
.dog-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dog-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dot {
  color: var(--text-muted);
}

/* Right: Actions */
.dog-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.current-tag {
  font-size: 20rpx;
  color: var(--primary-deep);
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* Line-style buttons */
.btn-line {
  font-size: 22rpx;
  padding: 10rpx 22rpx;
  border-radius: var(--radius-full);
  border: 2rpx solid var(--border);
  background: var(--card-bg);
  color: var(--text);
  letter-spacing: 1rpx;
  line-height: 1;
}
.btn-line::after {
  border: none;
}
.btn-line:active {
  background: var(--text);
  color: var(--card-bg);
}

.btn-edit {
  border-color: var(--primary);
  color: var(--primary-deep);
}
.btn-edit:active {
  background: var(--primary);
  color: #FFFFFF;
}

.btn-del {
  border-color: var(--danger);
  color: var(--danger);
}
.btn-del:active {
  background: var(--danger);
  color: #FFFFFF;
}

/* ── Add Dog ── */
.add-dog-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-lg);
  margin: var(--space-md) var(--page-padding);
  border: 2rpx dashed var(--border);
  border-radius: var(--radius);
  background: rgba(247, 243, 223, 0.62);
}
.add-dog-area:active {
  background: var(--primary-light);
}

.add-icon-img {
  width: 88rpx;
  height: 88rpx;
  display: block;
  margin-bottom: var(--space-sm);
}
.add-label {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.empty-hero-icon {
  width: 168rpx;
  height: 168rpx;
  display: block;
  margin-bottom: var(--space-lg);
}

/* ── Settings ── */
.settings-row {
  padding: 28rpx 0;
}
.settings-row-main {
  display: flex;
  align-items: center;
  min-width: 0;
}
.settings-icon-img {
  width: 56rpx;
  height: 56rpx;
  display: block;
  margin-right: var(--space-sm);
  flex-shrink: 0;
}
.settings-item-title {
  font-size: var(--font-md);
  font-weight: 700;
}
.settings-arrow {
  font-size: 40rpx;
  font-weight: 200;
  color: var(--text-muted);
}
