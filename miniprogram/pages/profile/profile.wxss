.profile-page {
  min-height: 100vh;
  padding: 24rpx 0 calc(132rpx + env(safe-area-inset-bottom));
}

.profile-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx var(--page-padding) var(--space-sm);
  padding: 24rpx 28rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--paper);
  box-shadow: var(--shadow-sm);
}

.profile-kicker {
  color: var(--primary-deep);
  font-size: var(--font-xs);
  font-weight: 900;
}

.profile-title {
  color: var(--text);
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.15;
}

.profile-count {
  padding: 8rpx 18rpx;
  border-radius: var(--radius-full);
  background: var(--honey-light);
  color: #9B6417;
  font-size: var(--font-sm);
  font-weight: 900;
}

.dog-card {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin: var(--space-sm) var(--page-padding);
  padding: 22rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  background: var(--paper);
  box-shadow: var(--shadow-sm);
}

.dog-card.is-active {
  border-color: var(--primary);
  background: var(--primary-light);
}

.dog-avatar {
  width: 100rpx;
  height: 100rpx;
  border: 4rpx solid #FFFFFF;
  border-radius: 50%;
  background: var(--paper-deep);
  box-shadow: 0 3rpx 0 #D8C6A6;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.dog-avatar image {
  width: 100%;
  height: 100%;
}

.avatar-icon-img {
  width: 84rpx;
  height: 84rpx;
}

.dog-info {
  min-width: 0;
  flex: 1;
}

.dog-name {
  color: var(--text);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dog-meta {
  margin-top: 2rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dot { color: var(--text-muted); }

.current-tag {
  display: inline-flex;
  margin-top: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-full);
  background: var(--paper);
  color: var(--primary-deep);
  font-size: 20rpx;
  font-weight: 900;
}

.dog-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
}

.btn-line {
  min-width: 92rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-full);
  background: var(--paper-soft);
  color: var(--text);
  font-size: 22rpx;
  font-weight: 800;
}

.btn-edit {
  border-color: var(--primary);
  color: var(--primary-deep);
}

.btn-del {
  border-color: var(--danger);
  color: var(--danger);
}

.add-dog-area {
  min-height: 156rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  margin: var(--space-md) var(--page-padding);
  border: 3rpx dashed var(--border);
  border-radius: var(--radius);
  background: rgba(255, 249, 232, 0.70);
}

.add-dog-area:active {
  background: var(--primary-light);
}

.add-icon-img {
  width: 78rpx;
  height: 78rpx;
}

.add-label {
  color: var(--text);
  font-size: var(--font-md);
  font-weight: 900;
}

.settings-card {
  padding-top: 10rpx;
  padding-bottom: 10rpx;
}

.settings-row {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.settings-row-main {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
}

.settings-icon-img {
  width: 58rpx;
  height: 58rpx;
  margin-right: var(--space-sm);
  flex-shrink: 0;
}

.settings-item-title {
  color: var(--text);
  font-size: var(--font-md);
  font-weight: 900;
}

.settings-desc {
  color: var(--text-secondary);
  font-size: var(--font-sm);
}

.settings-arrow {
  color: var(--text-muted);
  font-size: 48rpx;
  line-height: 1;
}
