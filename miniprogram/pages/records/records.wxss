.records-page {
  min-height: 100vh;
  padding: 24rpx 0 calc(132rpx + env(safe-area-inset-bottom));
}

.records-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx var(--page-padding) var(--space-sm);
  padding: 24rpx 28rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--paper);
  box-shadow: var(--shadow-sm);
}

.records-kicker {
  color: var(--primary-deep);
  font-size: var(--font-xs);
  font-weight: 900;
}

.records-title {
  color: var(--text);
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.15;
}

.records-header-icon {
  width: 86rpx;
  height: 86rpx;
}

.segment-bar-3 .segment-item {
  font-size: var(--font-sm);
}

.records-list {
  margin-top: var(--space-sm);
}

.record-card {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  min-height: 132rpx;
  padding: 22rpx 20rpx;
}

.record-card:active {
  transform: translateY(3rpx);
}

.record-mark {
  width: 22rpx;
  height: 58rpx;
  border-radius: var(--radius-full);
  background: var(--primary);
  flex-shrink: 0;
}

.record-mark.deworm { background: var(--honey); }
.record-mark.food { background: var(--wood-light); }

.record-main {
  min-width: 0;
  flex: 1;
}

.record-title {
  color: var(--text);
  font-size: var(--font-md);
  font-weight: 900;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-meta-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 4rpx;
}

.record-meta {
  color: var(--text-secondary);
  font-size: var(--font-sm);
}

.record-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
}

.record-delete {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--border-light);
  border-radius: 50%;
  background: var(--paper-deep);
}

.record-delete:active {
  border-color: var(--danger);
  background: var(--danger-light);
}

.delete-icon {
  color: var(--text-muted);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
}

.record-delete:active .delete-icon {
  color: var(--danger);
}
