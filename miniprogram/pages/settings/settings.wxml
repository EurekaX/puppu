<view class="settings-page">
  <view class="settings-hero animate-fade-in">
    <view>
      <view class="settings-kicker">小岛邮局</view>
      <view class="settings-title">设置</view>
    </view>
    <image class="settings-hero-icon" src="/images/animal-icons/settings-leaf.png" mode="aspectFit" />
  </view>

  <view class="section-title">通知</view>
  <view class="card settings-card">
    <view class="settings-row">
      <view class="settings-copy">
        <view class="settings-label">疫苗到期提醒</view>
        <view class="settings-desc">到期前推送微信提醒</view>
      </view>
      <switch checked="{{vaccineNotify}}" bindchange="onVaccineNotifyChange" color="#86B56C" />
    </view>
    <view class="divider"></view>
    <view class="settings-row">
      <view class="settings-copy">
        <view class="settings-label">驱虫到期提醒</view>
        <view class="settings-desc">只提醒同类型最新驱虫记录</view>
      </view>
      <switch checked="{{dewormNotify}}" bindchange="onDewormNotifyChange" color="#86B56C" />
    </view>
  </view>

  <view class="card settings-card mt-sm">
    <view class="subscribe-row">
      <view class="settings-copy">
        <view class="settings-label">消息订阅</view>
        <view class="settings-desc" wx:if="{{hasSubscribed}}">已授权，到期前将推送微信通知</view>
        <view class="settings-desc" wx:else>授权后可接收到期提醒</view>
      </view>
      <button class="btn btn-outline btn-sm" bindtap="onSubscribe">{{hasSubscribed ? '已授权' : '去授权'}}</button>
    </view>
  </view>

  <view class="section-title">数据</view>
  <view class="card settings-card">
    <view class="settings-row action-row" bindtap="onExportData">
      <view class="settings-copy">
        <view class="settings-label">导出数据</view>
        <view class="settings-desc">复制全部记录为 JSON</view>
      </view>
      <text class="settings-arrow">›</text>
    </view>
    <view class="divider"></view>
    <view class="settings-row action-row" bindtap="onClearData">
      <view class="settings-copy">
        <view class="settings-label danger-text">清除所有数据</view>
        <view class="settings-desc">永久删除所有本地记录</view>
      </view>
      <text class="settings-arrow">›</text>
    </view>
  </view>

  <view class="version-info">
    <text>宠安记</text>
    <text class="text-muted">v1.0.0</text>
  </view>
</view>
