.settings-page {
  min-height: 100vh;
  padding-bottom: var(--space-2xl);
}

.settings-row {
  padding: 28rpx 0;
}

.settings-label {
  font-size: var(--font-md);
  font-weight: 400;
  letter-spacing: 0.5rpx;
}
.settings-desc {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-top: 2rpx;
}
.settings-arrow {
  font-size: 40rpx;
  font-weight: 200;
  color: var(--text-muted);
}

.version-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-2xl) 0;
  gap: var(--space-xs);
  font-size: var(--font-sm);
  letter-spacing: 1rpx;
}
