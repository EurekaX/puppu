.settings-page {
  min-height: 100vh;
  padding: 24rpx 0 var(--space-2xl);
}

.settings-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx var(--page-padding) var(--space-sm);
  padding: 24rpx 28rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--paper);
  box-shadow: var(--shadow-sm);
}

.settings-kicker {
  color: var(--primary-deep);
  font-size: var(--font-xs);
  font-weight: 900;
}

.settings-title {
  color: var(--text);
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.15;
}

.settings-hero-icon {
  width: 86rpx;
  height: 86rpx;
}

.settings-card {
  padding-top: 10rpx;
  padding-bottom: 10rpx;
}

.settings-row, .subscribe-row {
  min-height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
}

.settings-copy {
  min-width: 0;
  flex: 1;
}

.settings-label {
  color: var(--text);
  font-size: var(--font-md);
  font-weight: 900;
}

.settings-desc {
  margin-top: 2rpx;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  line-height: 1.45;
}

.settings-arrow {
  color: var(--text-muted);
  font-size: 48rpx;
  line-height: 1;
}

.danger-text {
  color: var(--danger);
}

.version-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-xs);
  padding: var(--space-2xl) 0;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  font-weight: 700;
}
